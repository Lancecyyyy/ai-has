# --- Required in production ---
# Long random string used to sign session cookies (openssl rand -base64 32)
AUTH_SECRET=

# --- Database ---
# Postgres connection string (Neon / Supabase / Vercel Postgres). When empty, an
# embedded Postgres (PGlite) runs in memory and is re-seeded on every cold start.
DATABASE_URL=

# --- AI model (optional) ---
# When set, answers are generated by GPT-4o-mini grounded on retrieved manual chunks.
# When empty, the built-in extractive engine composes answers from the same chunks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Automation hooks (optional) ---
# n8n / Make webhook that receives every automation run (JSON POST)
AUTOMATION_WEBHOOK_URL=
# Jira / ticketing webhook that receives every escalated ticket (JSON POST)
TICKET_WEBHOOK_URL=

# --- Email (password reset links and automation confirmations) ---
# Gmail account + 16-character app password (Google Account > Security > App passwords).
# Or set SMTP_URL (smtps://user:pass@host:465) for any other mail server.
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_URL=
# Optional "From" header, e.g.  Meridian IT <you@gmail.com>
MAIL_FROM=
# Demo accounts use fake @meridian.example addresses; their mail is delivered here instead.
DEMO_INBOX=
# Public address used in emailed links (defaults to the address the request came in on)
APP_URL=

# Set to "off" to hide the one-click demo logins on the sign-in page
DEMO_LOGIN=on
