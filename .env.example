# --- Required in production ---
# Long random string used to sign session cookies (openssl rand -base64 32)
AUTH_SECRET=

# --- Database ---
# Postgres connection string (Neon / Supabase / Vercel Postgres). When empty, an
# embedded Postgres (PGlite) runs in memory and is re-seeded on every cold start.
DATABASE_URL=

# --- AI model (optional) ---
# When set, answers are generated by GPT-4o-mini grounded on retrieved manual chunks.
# When empty, the built-in extractive engine composes answers from the same chunks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Automation hooks (optional) ---
# n8n / Make webhook that receives every automation run (JSON POST)
AUTOMATION_WEBHOOK_URL=
# Jira / ticketing webhook that receives every escalated ticket (JSON POST)
TICKET_WEBHOOK_URL=

# Set to "off" to hide the one-click demo logins on the sign-in page
DEMO_LOGIN=on
